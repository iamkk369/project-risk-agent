# AgentCore Runtime environment variables.
# Configure these through the AgentCore deployment/runtime environment mechanism,
# not by committing real credentials to source control.
AWS_REGION=us-east-1
GITHUB_REPO=owner/repository
GITHUB_TOKEN=replace-me
GITHUB_WEBHOOK_SECRET=replace-me
GEMINI_API_KEY=replace-me
GEMINI_MODEL_ID=gemini-3.6-flash
RISK_HISTORY_FILE=/tmp/.risk_history.json
GITHUB_TOKEN_SECRET_ARN=
GEMINI_API_KEY_SECRET_ARN=
LOG_LEVEL=INFO
SERVICE_NAME=project-risk-agent
