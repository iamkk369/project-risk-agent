GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO=iamkk369/risk-agent-demo
GEMINI_API_KEY=your_gemini_api_key_here
AWS_REGION=us-east-1

# Event-driven GitHub webhook listener
GITHUB_WEBHOOK_SECRET=your_webhook_secret
WEBHOOK_EVENT_LOG=.webhook_events.jsonl

# Optional AWS Secrets Manager integration for deployed credentials.
# When an ARN is set, it takes precedence over the corresponding env value.
GITHUB_TOKEN_SECRET_ARN=
GEMINI_API_KEY_SECRET_ARN=
LOG_LEVEL=INFO
SERVICE_NAME=project-risk-agent

# Optional portfolio mode: comma-separated GitHub repositories.
PROJECT_REPOS=iamkk369/risk-agent-demo

# Optional durable report persistence
S3_REPORT_BUCKET=
S3_REPORT_PREFIX=risk-reports
